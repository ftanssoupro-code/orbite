# À renseigner dans Vercel → Settings → Environment Variables
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_ANON_KEY=clé publique "anon" / "publishable" du projet Supabase
ANTHROPIC_API_KEY=clé secrète de l'API Claude (ne jamais la mettre dans le code)
# Optionnel : nombre maximal d'appels IA par élève et par jour (défaut 80)
AI_DAILY_LIMIT=80
